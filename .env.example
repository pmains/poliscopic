# Bluesky social media publishing
# Get app password from Bluesky Settings > App Passwords
# The handle should be the full DID handle (e.g., user.bsky.social)
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Persistent development data uses PostgreSQL. The database name must remain
# development-classified (for example, end in _dev or _development).
POLISCOPIC_DB_TIER=development
DATABASE_URL=postgresql://user:password@localhost:5432/poliscopic_dev

# Web application security. Generate a long random secret independently for
# each deployed environment. Use false only for local HTTP development;
# production refuses insecure cookies.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
POLISCOPIC_COOKIE_SECURE=false

# Newsletter delivery. Keep the signing secret identical anywhere action links
# are minted or verified. Owner addresses receive fallback/test delivery and
# workflow failure notifications; comma-separate multiple recipients.
PUBLIC_BASE_URL=https://poliscopic.example
NEWSLETTER_TOKEN_SECRET=replace-with-a-separate-long-random-secret
NEWSLETTER_OWNER_EMAILS=owner@example.com
EMAIL_APP_PASSWORD=replace-with-your-smtp-app-password

# Usage:
#   python scripts/bluesky_sync.py --limit=10          # Post the 10 most recent unpublished articles
#   python scripts/bluesky_sync.py --article=17         # Post a specific article
#   python scripts/bluesky_sync.py --force --limit=5    # Re-post even if already posted
#   python scripts/bluesky_sync.py --dry-run            # Preview without posting
#   python scripts/bluesky_sync.py --url=https://poliscopic.com  # Override base URL

# Run after ./sync.sh to announce new articles on Bluesky.
